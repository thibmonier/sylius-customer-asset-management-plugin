{% set context = hookable_metadata.context %}

{% include '@SyliusShop/shared/flashes.html.twig' %}

<p>
    <a class="btn btn-primary" href="{{ path('tmonier_equipment_shop_fleet_create') }}" {{ sylius_test_html_attribute('tmonier-equipment-add') }}>{{ 'tmonier_equipment.ui.add_machine'|trans }}</a>
</p>

{% if context.assets is empty %}
    <p class="text-body-secondary" {{ sylius_test_html_attribute('tmonier-equipment-empty') }}>{{ 'tmonier_equipment.ui.no_machines'|trans }}</p>
{% else %}
    <div class="table-responsive">
        <table class="table align-middle" {{ sylius_test_html_attribute('tmonier-equipment-assets') }}>
            <caption class="visually-hidden">{{ 'tmonier_equipment.ui.my_equipment'|trans }}</caption>
            <thead>
                <tr>
                    <th scope="col">{{ 'tmonier_equipment.ui.label'|trans }}</th>
                    <th scope="col">{{ 'tmonier_equipment.ui.equipment_model'|trans }}</th>
                    <th scope="col">{{ 'tmonier_equipment.ui.identifier'|trans }}</th>
                    <th scope="col"><span class="visually-hidden">{{ 'tmonier_equipment.ui.actions'|trans }}</span></th>
                </tr>
            </thead>
            <tbody>
                {% for asset in context.assets %}
                    <tr {{ sylius_test_html_attribute('tmonier-equipment-asset', asset.id) }}>
                        <th scope="row">{{ asset.label }}</th>
                        <td>{{ asset.equipmentModel.name is not null ? asset.equipmentModel.name : asset.equipmentModel.code }}</td>
                        <td>{{ asset.identifier }}</td>
                        <td class="text-end">
                            <div class="d-flex gap-2 justify-content-end">
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('tmonier_equipment_shop_fleet_update', {'id': asset.id}) }}">{{ 'sylius.ui.edit'|trans }}<span class="visually-hidden"> ({{ asset.label }})</span></a>
                                <form method="post" action="{{ path('tmonier_equipment_shop_fleet_delete', {'id': asset.id}) }}" data-turbo-confirm="{{ 'tmonier_equipment.ui.confirm_delete'|trans }}">
                                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('tmonier_equipment_asset_delete_' ~ asset.id) }}">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">{{ 'sylius.ui.delete'|trans }}<span class="visually-hidden"> ({{ asset.label }})</span></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endif %}
<p class="text-body-secondary small mt-3">{{ 'tmonier_equipment.ui.fleet_help'|trans }}</p>
