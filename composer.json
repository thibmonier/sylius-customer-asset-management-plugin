{
    "name": "tmonier/sylius-customer-asset-management-plugin",
    "type": "sylius-plugin",
    "description": "Customer asset management for Sylius 2: customers declare their equipment fleet and the catalogue can be filtered to the compatible spare parts",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "b2b",
        "customer-assets",
        "equipment",
        "spare-parts"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sylius/sylius": "^2.2.9 || ^2.3"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-webmozart-assert": "^2.0",
        "phpunit/phpunit": "^10.5",
        "rector/rector": "^2.0",
        "sylius-labs/coding-standard": "^4.4",
        "sylius/test-application": "^2.0.0@alpha",
        "symfony/browser-kit": "^6.4 || ^7.4 || ^8.0",
        "symfony/css-selector": "^6.4 || ^7.4 || ^8.0",
        "symfony/debug-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/dom-crawler": "^6.4 || ^7.4 || ^8.0",
        "symfony/dotenv": "^6.4 || ^7.4 || ^8.0",
        "symfony/http-client": "^6.4 || ^7.4 || ^8.0",
        "symfony/intl": "^6.4 || ^7.4 || ^8.0",
        "symfony/runtime": "^6.4 || ^7.4 || ^8.0",
        "symfony/web-profiler-bundle": "^6.4 || ^7.4 || ^8.0",
        "symfony/webpack-encore-bundle": "^2.2",
        "tmonier/sylius-company-accounts-plugin": "^1.3"
    },
    "suggest": {
        "tmonier/sylius-company-accounts-plugin": "The fleet of a customer is shared with the members of the customer's company"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false,
            "php-http/discovery": false,
            "phpstan/extension-installer": true,
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "policy": {
            "advisories": {
                "block": true,
                "audit": "fail"
            },
            "abandoned": {
                "block": false,
                "audit": "report"
            },
            "malware": {
                "block": true,
                "block-scope": "all",
                "audit": "fail"
            }
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.1-dev"
        },
        "symfony": {
            "require": "^7.4"
        },
        "public-dir": "vendor/sylius/test-application/public"
    },
    "autoload": {
        "psr-4": {
            "Tmonier\\SyliusCustomerAssetManagementPlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Tmonier\\SyliusCustomerAssetManagementPlugin\\": [
                "tests/",
                "tests/TestApplication/src/"
            ]
        }
    },
    "scripts": {
        "database-reset": [
            "vendor/bin/console doctrine:database:drop --force --if-exists",
            "vendor/bin/console doctrine:database:create",
            "vendor/bin/console doctrine:migration:migrate -n",
            "vendor/bin/console sylius:fixtures:load -n"
        ],
        "frontend-clear": [
            "cd vendor/sylius/test-application && yarn install && yarn build",
            "vendor/bin/console assets:install"
        ],
        "test-app-init": [
            "@database-reset",
            "@frontend-clear"
        ]
    },
    "authors": [
        {
            "name": "Thibaut Monier"
        }
    ]
}
